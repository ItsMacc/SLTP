# Copy to .env and fill in. .env itself is gitignored — never commit secrets.
# cp .env.example .env

# ---- Supabase: auth + the small profile row and churn log ----
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE=<service-role-key>

# Only for older projects that still sign sessions with the HS256 secret.
SUPABASE_JWT=

# ---- Turso: everything bulky, keyed by the Supabase uid ----
TURSO_DATABASE_URL=libsql://<your-database>.turso.io
TURSO_AUTH_TOKEN=<token>

# ---- Mail: Gmail SMTP that sends the account + operator mail ----
SENDER_EMAIL=
APP_PASSWORD=<google-app-password>

# Operator mail goes here; unset and it falls back to SENDER_EMAIL.
ADMIN_EMAIL=

# ---- R2 market data: nightly updater + one-off scripts ----
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Endpoint: either the full URL or just the account id.
CLOUDFLARE_URL=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET=sltp-market-data

# ---- R2 billing readout (scripts/r2_usage.py only) ----
CLOUDFLARE_API_TOKEN=<token-with-analytics-read>

# ---- Frontend: where the API lives (used by npm run dev) ----
VITE_API_BASE_URL=http://localhost:8000
