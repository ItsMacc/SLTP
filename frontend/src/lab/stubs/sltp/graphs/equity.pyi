from dataclasses import dataclass
from sltp.graphs.palette import color_at as color_at

FONT: str
TEXT: str
MUTED: str
GRID: str
AXIS: str
BACKGROUND: str
WIDTH: int
PAD_LEFT: int
PAD_RIGHT: int
HEADER: int
MAIN_HEIGHT: int
PANEL_GAP: int
PANEL_HEIGHT: int
PAD_BOTTOM: int

@dataclass
class ChartSeries:
    name: str
    dates: list[str]
    values: list[float]
    color: str | None = ...
    note: str | None = ...
    def __post_init__(self) -> None: ...
    @classmethod
    def from_equity(cls, name: str, equity: list[dict], color: str | None = None, note: str | None = None) -> ChartSeries: ...
    @property
    def final(self) -> float: ...

def _nice_step(span: float, target: int = 5) -> float: ...
def _ticks(low: float, high: float, target: int = 5) -> list[float]: ...
def _number(value: float, digits: int = 1) -> str: ...
def _month_label(value: str) -> str: ...
def _positions(series: list[ChartSeries]) -> tuple[list[str], dict[str, int]]: ...
def _line_path(item: ChartSeries, x_of, y_of, index_of: dict[str, int]) -> tuple[str, bool]: ...
def _legend_rows(series: list[ChartSeries], available: float) -> list[list[tuple[str, str, float]]]: ...
def equity_chart(series: list[ChartSeries], title: str = 'Equity', subtitle: str | None = None, width: int = ..., show_drawdown: bool = True, start_value: float | None = None) -> str: ...
def write_chart(path: str, svg: str) -> str: ...
